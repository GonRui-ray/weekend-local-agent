# Cloud runtime. Configure credentials in platform secret variables.
HOST=0.0.0.0
PORT=7860
# Model understanding is optional; missing model uses bounded rules.
MODEL_API_KEY=
MODEL_BASE_URL=https://api-inference.modelscope.cn/v1
MODEL_NAME=Qwen/Qwen3-32B
# Required for real local recommendations across mainland Chinese cities.
AMAP_KEY=
# Public web discovery across official / local-life / Xiaohongshu-indexed pages.
TAVILY_KEY=
# Optional: authorized source gateway implementing event-feed.schema.json.
# For a live demo configure Tavily and/or an actual populated activity feed.
EVENT_FEED_URL=
EVENT_FEED_TOKEN=
# Or a platform-uploaded, maintained JSON file. Do not use the empty template as a data source.
EVENT_FEED_PATH=
# Optional comma-separated GitHub Pages origin when frontend and API are separate.
# Example: https://your-user.github.io (no repository path).
CORS_ORIGINS=
