{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "events"
  ],
  "properties": {
    "events": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "city",
          "title",
          "venue",
          "category",
          "startsOn",
          "endsOn",
          "url",
          "kind",
          "publisher"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "venue": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "category": {
            "enum": [
              "看展",
              "火锅",
              "咖啡",
              "散步",
              "逛街",
              "餐饮"
            ]
          },
          "startsOn": {
            "type": "string",
            "format": "date"
          },
          "endsOn": {
            "type": "string",
            "format": "date"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "kind": {
            "enum": [
              "official",
              "local_life",
              "social"
            ]
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "publishedAt": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40
          },
          "price": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 2000
          },
          "summary": {
            "type": "string",
            "maxLength": 600
          }
        }
      }
    }
  }
}
