{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Weekend Box Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "request",
    "meta",
    "plans"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "city",
        "date",
        "budget",
        "maxDistanceKm",
        "preferences",
        "people",
        "commonWindow"
      ],
      "properties": {
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "budget": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000
        },
        "maxDistanceKm": {
          "enum": [
            1,
            3,
            5,
            10
          ]
        },
        "preferences": {
          "type": "array",
          "items": {
            "enum": [
              "看展",
              "火锅",
              "咖啡",
              "散步",
              "逛街"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "people": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "location",
              "availableFrom",
              "availableTo"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "location": {
                "type": "string"
              },
              "availableFrom": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "availableTo": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              }
            }
          },
          "minItems": 1,
          "maxItems": 6
        },
        "commonWindow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            "to": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            }
          }
        },
        "residentArea": {
          "type": "string",
          "maxLength": 60
        },
        "maxCommuteMinutes": {
          "enum": [
            30,
            45,
            60
          ]
        },
        "avoidPlaces": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "audience": {
          "const": "resident"
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "generatedAt",
        "provider",
        "dataNote",
        "warnings",
        "commonWindow",
        "activitySearch"
      ],
      "properties": {
        "mode": {
          "enum": [
            "demo",
            "live",
            "degraded"
          ]
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "provider": {
          "enum": [
            "amap",
            "local-demo"
          ]
        },
        "dataNote": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commonWindow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            "to": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            }
          }
        },
        "activitySearch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "provider",
            "checkedAt"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_configured",
                "not_needed",
                "completed",
                "partial",
                "unavailable"
              ]
            },
            "provider": {
              "enum": [
                null,
                "tavily",
                "feed",
                "mixed"
              ]
            },
            "checkedAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          }
        },
        "preview": {
          "type": "boolean"
        },
        "information": {
          "type": "object",
          "required": [
            "channels",
            "rejectedRecords"
          ],
          "additionalProperties": false,
          "properties": {
            "rejectedRecords": {
              "type": "integer",
              "minimum": 0
            },
            "channels": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "label",
                  "status",
                  "count"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "completed",
                      "not_configured",
                      "unavailable",
                      "empty",
                      "partial"
                    ]
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    "plans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "subtitle",
          "tags",
          "theme",
          "startTime",
          "endTime",
          "totalMinutes",
          "totalDistanceKm",
          "meetingPoint",
          "budgetPerPerson",
          "arrivals",
          "stops",
          "transfers",
          "invitation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "theme": {
            "enum": [
              "peach",
              "sage",
              "lilac"
            ]
          },
          "startTime": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "endTime": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "totalMinutes": {
            "type": "integer",
            "minimum": 0
          },
          "totalDistanceKm": {
            "type": "number",
            "minimum": 0
          },
          "meetingPoint": {
            "type": "string"
          },
          "budgetPerPerson": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "total",
              "currency",
              "activities",
              "transport",
              "estimated"
            ],
            "properties": {
              "total": {
                "type": "number",
                "minimum": 0
              },
              "currency": {
                "const": "CNY"
              },
              "activities": {
                "type": "number",
                "minimum": 0
              },
              "transport": {
                "type": "number",
                "minimum": 0
              },
              "estimated": {
                "const": true
              }
            }
          },
          "arrivals": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "from",
                "minutes",
                "returnMinutes",
                "estimated"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "from": {
                  "type": "string"
                },
                "minutes": {
                  "type": "integer",
                  "minimum": 0
                },
                "returnMinutes": {
                  "type": "integer",
                  "minimum": 0
                },
                "estimated": {
                  "const": true
                }
              }
            },
            "minItems": 1,
            "maxItems": 6
          },
          "stops": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "order",
                "name",
                "category",
                "address",
                "location",
                "startTime",
                "endTime",
                "durationMinutes",
                "costEstimate",
                "description",
                "activitySources",
                "source"
              ],
              "properties": {
                "order": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3
                },
                "name": {
                  "type": "string"
                },
                "category": {
                  "enum": [
                    "看展",
                    "火锅",
                    "咖啡",
                    "散步",
                    "逛街",
                    "餐饮"
                  ]
                },
                "address": {
                  "type": "string"
                },
                "location": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "lng",
                    "lat"
                  ],
                  "properties": {
                    "lng": {
                      "type": "number",
                      "minimum": 73,
                      "maximum": 136
                    },
                    "lat": {
                      "type": "number",
                      "minimum": 3,
                      "maximum": 54
                    }
                  }
                },
                "startTime": {
                  "type": "string",
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                },
                "endTime": {
                  "type": "string",
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                },
                "durationMinutes": {
                  "type": "integer",
                  "minimum": 0
                },
                "costEstimate": {
                  "type": "number",
                  "minimum": 0
                },
                "description": {
                  "type": "string"
                },
                "activitySources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "title",
                      "url",
                      "snippet",
                      "checkedAt",
                      "verification"
                    ],
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string",
                        "format": "uri"
                      },
                      "snippet": {
                        "type": "string"
                      },
                      "checkedAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "verification": {
                        "enum": [
                          "search_result",
                          "provider_record"
                        ]
                      },
                      "kind": {
                        "enum": [
                          "official",
                          "local_life",
                          "social",
                          "web"
                        ]
                      },
                      "publisher": {
                        "type": "string"
                      },
                      "publishedAt": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "eventStart": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "eventEnd": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  },
                  "maxItems": 5
                },
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "provider",
                    "url",
                    "checkedAt",
                    "verification"
                  ],
                  "properties": {
                    "provider": {
                      "type": "string"
                    },
                    "url": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "uri"
                    },
                    "checkedAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    },
                    "verification": {
                      "enum": [
                        "sample",
                        "poi_verified"
                      ]
                    }
                  }
                }
              }
            },
            "minItems": 3,
            "maxItems": 3
          },
          "transfers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to",
                "distanceKm",
                "minutes",
                "mode",
                "estimated"
              ],
              "properties": {
                "from": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1
                },
                "to": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2
                },
                "distanceKm": {
                  "type": "number",
                  "minimum": 0
                },
                "minutes": {
                  "type": "integer",
                  "minimum": 0
                },
                "mode": {
                  "const": "步行"
                },
                "estimated": {
                  "const": true
                }
              }
            },
            "minItems": 2,
            "maxItems": 2
          },
          "invitation": {
            "type": "string"
          }
        }
      },
      "minItems": 1,
      "maxItems": 3
    }
  }
}
